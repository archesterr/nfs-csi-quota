#!/usr/bin/env bash
# {{ ansible_managed }}
# Per-PVC ext4 project quota sync — mode: {{ nfs_csi_quota_mode }}
set -uo pipefail
EXPORT={{ nfs_csi_quota_export_path }}
export KUBECONFIG={{ nfs_csi_quota_kubeconfig }}
TIMEOUT={{ nfs_csi_quota_kubectl_timeout }}
{% if nfs_csi_quota_metrics_enabled | bool %}
T={{ nfs_csi_quota_textfile_dir }}
TMP=$(mktemp)

# --- API server connectivity health check (own gauge — a silent kubectl
# failure below would otherwise just mean "0 PVs synced", not an alertable
# signal). Bounded by --request-timeout so a dead API can't stall the tick.
if kubectl --request-timeout="$TIMEOUT" get --raw=/healthz >/dev/null 2>&1; then
  echo "nfs_csi_quota_kubeapi_up 1" >> "$TMP"
else
  echo "nfs_csi_quota_kubeapi_up 0" >> "$TMP"
fi
{% endif %}

kubectl --request-timeout="$TIMEOUT" get pv -o json |
jq -r '.items[] | select(.spec.csi.driver=="{{ nfs_csi_quota_csi_driver }}")
       | "\(.metadata.name) \(.spec.capacity.storage) \(.spec.claimRef.namespace) \(.spec.claimRef.name)"' |
while read -r pv size ns claim; do
  dir="$EXPORT/$pv"
  [ -d "$dir" ] || continue
  bytes=$(numfmt --from=auto "$size")
  id=$(( 0x$(md5sum <<<"$pv" | cut -c1-7) ))

  cur=$(lsattr -pd "$dir" 2>/dev/null | awk '{print $1}')
  if [ "${cur:-}" != "$id" ]; then
    # ext4: inherit flag (+P) is directory-only; files take the project id alone
    find "$dir" -type d -print0 | xargs -0 -r chattr -p "$id" +P 2>&1 | grep -v 'No such file' >&2
    find "$dir" -type f -print0 | xargs -0 -r chattr -p "$id" 2>&1 | grep -v 'No such file' >&2
  fi

{% if nfs_csi_quota_mode == 'enforce' %}
  # ENFORCE MODE: hard limit == PVC declared size (EDQUOT past capacity)
  if err=$(setquota -P "$id" 0 $((bytes/1024)) 0 0 "$EXPORT" 2>&1); then
    echo "OK: $pv id=$id limit=$size"
  else
    echo "ERR: setquota $pv id=$id: $err"
  fi
{% else %}
  # ALERT-ONLY MODE: accounting without enforcement (limits stay 0)
  setquota -P "$id" 0 0 0 0 "$EXPORT"
{% endif %}
{% if nfs_csi_quota_metrics_enabled | bool %}

  echo "nfs_csi_quota_info{projid=\"$id\",pv=\"$pv\",namespace=\"$ns\",pvc=\"$claim\"} 1" >> "$TMP"
  echo "nfs_csi_quota_limit_bytes{projid=\"$id\"} $bytes" >> "$TMP"
{% endif %}
done
{% if nfs_csi_quota_metrics_enabled | bool %}

repquota -P "$EXPORT" | awk '$1 ~ /^#[0-9]+$/ {
  gsub(/^#/,"",$1)
  printf "nfs_csi_quota_used_bytes{projid=\"%s\"} %.0f\n", $1, $3*1024}' >> "$TMP"

mv "$TMP" "$T/nfs_csi_quota.prom" && chmod 644 "$T/nfs_csi_quota.prom"
{% endif %}
